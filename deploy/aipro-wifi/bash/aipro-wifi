#!/usr/bin/env bash
# aipro-wifi — AP 一键开关（aipro 上，装于 ~/.local/bin/）
#
# 用法:
#   aipro-wifi on/off/status
#   aipro-wifi gnpon    # AP 出海走透明代理(默认)
#   aipro-wifi gnpoff   # AP 走原通道 NAT 直连(分流不稳时应急)
#
# 设计: 开机链已全自动(udev+modalias), 日常开关只需 docker(lwboy 免密);
#       模块操作需 root — 有免密 sudo 或以 root 运行时自动补, 否则提示。
set -u
CMD="${1:-status}"
AIC=/lib/modules/5.10.0+/kernel/drivers/net/wireless/aic8800
CONTAINER=aipro-wifi-router

as_root() {  # 能提权则 echo "sudo -n" / root 则空 / 否则失败
  [ "$(id -u)" = 0 ] && return 0
  sudo -n true 2>/dev/null && return 0
  return 1
}
run_root() {  # run_root <cmd...>
  if [ "$(id -u)" = 0 ]; then "$@"; else sudo -n "$@"; fi
}

ensure_modules() {
  lsmod | grep -q "^aic8800_fdrv" && return 0
  if as_root; then
    echo "→ 补载 aic 模块链..."
    run_root insmod "$AIC/aic_load_fw.ko" 2>/dev/null
    sleep 8   # 固件下载 + 重枚举
    run_root insmod "$AIC/aic8800_fdrv.ko" 2>/dev/null
    sleep 4
    lsmod | grep -q "^aic8800_fdrv" && echo "  模块就绪" || { echo "  ✗ 模块加载失败"; return 1; }
  else
    echo "⚠️  aic 模块未加载且无免密 sudo（正常开机已自动加载，此为罕见场景）"
    return 1
  fi
}

cur_mode() { local m=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' $CONTAINER 2>/dev/null | grep ROUTER_MODE | cut -d= -f2); echo "${m:-proxy}"; }
cur_band() { local b=$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' $CONTAINER 2>/dev/null | grep WIFI_BAND | cut -d= -f2); echo "${b:-5g}"; }

# 以指定模式+频段重建容器 (proxy|direct, 5g|24g)
recreate() {
  local mode="$1" band="${2:-$(cur_band)}"
  ensure_modules || true
  ip link show wlan1 &>/dev/null || { echo "✗ wlan1 不存在"; exit 1; }
  local pass
  SECRET_FILE=/mnt/disk/lwboy/.local/share/sing-box/.hy2-secret
  if [ ! -s "$SECRET_FILE" ]; then
    local pass
    pass=$(python3 -c "import json;c=json.load(open('/mnt/disk/lwboy/.local/share/sing-box/config.json'));print(next(o['password'] for o in c['outbounds'] if o['type']=='hysteria2'))" 2>/dev/null || echo unused)
    (umask 077; printf '%s' "$pass" > "$SECRET_FILE")
  fi
  docker rm -f "$CONTAINER" >/dev/null 2>&1
  docker run -d --name "$CONTAINER" --network host --privileged \
    --restart unless-stopped \
    -v "$SECRET_FILE":/run/secrets/hy2_password:ro \
    -e ROUTER_MODE="$mode" -e WIFI_BAND="$band" -e WIFI_IFACE=wlan1 \
    aipro-wifi-router:latest >/dev/null
  for i in $(seq 1 15); do
    iw dev wlan1 info 2>/dev/null | grep -q "type AP" && break; sleep 1
  done
  if iw dev wlan1 info 2>/dev/null | grep -q "type AP"; then
    echo "✅ AP 已就绪 ($mode 模式 / $band 频段): $(iw dev wlan1 info | awk '/ssid/{print $2}')"
  else
    echo "✗ 未就绪: docker logs $CONTAINER"; exit 1
  fi
}

case "$CMD" in
  on)
    echo "== aipro-wifi ON =="
    ensure_modules || true
    if ip link show wlan1 &>/dev/null; then
      docker start "$CONTAINER" 2>/dev/null || docker restart "$CONTAINER"
      for i in $(seq 1 12); do
        iw dev wlan1 info 2>/dev/null | grep -q "type AP" && break; sleep 1
      done
      if iw dev wlan1 info 2>/dev/null | grep -q "type AP"; then
        echo "✅ AP 已开启: $(iw dev wlan1 info | awk '/ssid/{print $2}') ($(iw dev wlan1 info | awk '/channel/{print $2,$3}'))"
      else
        echo "✗ AP 未就绪, 查看: docker logs $CONTAINER"
        exit 1
      fi
    else
      echo "✗ wlan1 不存在（模块未加载）; docker logs $CONTAINER 排查"
      exit 1
    fi
    ;;
  off)
    echo "== aipro-wifi OFF =="
    docker stop "$CONTAINER" >/dev/null && echo "✅ AP 容器已停 (SSID aipro 消失)"
    as_root && run_root rmmod aic8800_fdrv aic_load_fw 2>/dev/null \
      && echo "  射频模块已卸载" || echo "  (模块保持加载, 仅停 AP)"
    ;;
  gnpon)
    echo "== AP 出海代理模式 (透明代理 hy2/QUIC) =="
    recreate proxy "$(cur_band)"
    ;;
  gnpoff)
    echo "== AP 原通道模式 (NAT 直连, 不走代理) =="
    recreate direct "$(cur_band)"
    ;;
  24ch)
    echo "== AP 切 2.4G ch1（穿墙覆盖优先）=="
    recreate "$(cur_mode)" 24g
    ;;
  5ch)
    echo "== AP 切 5G ch36（近距离高速）=="
    recreate "$(cur_mode)" 5g
    ;;
  status)
    echo "== aipro-wifi 状态 =="
    printf "  aic 模块: %s\n" "$(lsmod | grep -q '^aic8800_fdrv' && echo 已加载 || echo 未加载)"
    printf "  wlan1(AP): %s\n" "$(iw dev wlan1 info 2>/dev/null | grep -E 'ssid' | awk '{print $2}' || echo 不存在)"
    printf "  容器: %s\n" "$(docker ps -a --filter name=$CONTAINER --format '{{.Status}}')"
    printf "  出口模式: %s | 频段: %s\n" "$(cur_mode)" "$(cur_band)"
    printf "  客户端: %s\n" "$(iw dev wlan1 station dump 2>/dev/null | grep -c Station) 个"
    ;;
  *)
    echo "用法: aipro-wifi {on|off|status|gnpon|gnpoff|24ch|5ch}"
    echo "  gnpon   AP 客户端走透明代理出海(默认)"
    echo "  gnpoff  AP 客户端走原通道 NAT 直连(分流不稳时应急)"
    echo "  24ch    切 2.4G ch1(穿墙) / 5ch 切 5G ch36(高速); 频段跨模式保持"
    exit 1
    ;;
esac
