{
  "log": {
    "level": "debug",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-direct",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns-remote",
        "type": "tcp",
        "server": "1.1.1.1",
        "detour": "hy2-out"
      },
      {
        "tag": "dns-hosts",
        "type": "hosts",
        "path": [
          "/etc/hosts"
        ],
        "predefined": {
          "aipro.host": "192.168.1.2",
          "lwtop.host": "8.209.203.17",
          "mac.host": "127.0.0.1"
        }
      }
    ],
    "rules": [
      {
        "domain": [
          "aipro.host",
          "lwtop.host",
          "mac.host"
        ],
        "server": "dns-hosts"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "server": "dns-direct"
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-out",
      "server": "8.209.203.17",
      "server_port": 443,
      "password": "gnp-quic-test-password",
      "tls": {
        "enabled": true,
        "insecure": true
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rule_set": [
      {
        "type": "local",
        "tag": "geosite-cn",
        "format": "binary",
        "path": "/Users/lwboy/.local/share/sing-box/rules/geosite-cn.srs"
      },
      {
        "type": "local",
        "tag": "geoip-cn",
        "format": "binary",
        "path": "/Users/lwboy/.local/share/sing-box/rules/geoip-cn.srs"
      }
    ],
    "rules": [
      {
        "domain_suffix": [
          "aipro.host",
          "lwtop.host",
          "mac.host"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "final": "hy2-out"
  }
}