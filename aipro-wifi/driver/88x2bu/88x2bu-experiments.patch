From 4da32820a7f1354ed192561150b4c62ad208029c Mon Sep 17 00:00:00 2001
From: zcode <zcode@local>
Date: Sat, 15 Aug 2026 11:03:58 +0800
Subject: [PATCH 3/4] E2: log raw chip_id, force 8822B for c820, guard NULL api
 slots

---
 hal/hal_halmac.c        |  8 ++++++++
 hal/halmac/halmac_api.c | 15 +++++++++++++++
 2 files changed, 23 insertions(+)

diff --git a/hal/hal_halmac.c b/hal/hal_halmac.c
index aa1bbf9..9e4f863 100644
--- a/hal/hal_halmac.c
+++ b/hal/hal_halmac.c
@@ -1257,6 +1257,14 @@ int rtw_halmac_init_adapter(struct dvobj_priv *d, struct halmac_platform_api *pf
 
 	dvobj_set_halmac(d, halmac);
 
+	/* AIPRO-E2: guard against NULL api slots (incomplete per-chip mount).
+	 * Without this a NULL slot ends in pc=0x0 oops via blr. */
+	if (!api || !api->halmac_interface_integration_tuning || !api->halmac_phy_cfg) {
+		printk(KERN_ALERT "AIPRO8822BU: halmac api slots NULL, abort init\n");
+		err = -1;
+		goto deinit;
+	}
+
 	status = api->halmac_interface_integration_tuning(halmac);
 	if (status != HALMAC_RET_SUCCESS) {
 		RTW_ERR("%s: halmac_interface_integration_tuning fail!(status=%d)\n", __FUNCTION__, status);
diff --git a/hal/halmac/halmac_api.c b/hal/halmac/halmac_api.c
index d6f531d..56b6139 100644
--- a/hal/halmac/halmac_api.c
+++ b/hal/halmac/halmac_api.c
@@ -522,6 +522,21 @@ get_chip_info(void *drv_adapter, struct halmac_platform_api *pltfm_api,
 
 	adapter->chip_ver = (enum halmac_chip_ver)chip_ver;
 
+	/* AIPRO-E2: dump raw chip id/ver before mapping */
+	printk(KERN_ALERT "AIPRO8822BU: %s raw chip_id=0x%02x chip_ver=0x%02x intf=%d\n",
+	       __func__, chip_id, chip_ver, adapter->intf);
+
+	/* AIPRO-E2: c820 = RTL8812BU (8822B silicon). Any other value here is a
+	 * bad USB register read; wrong values in {8821C,8822C,8812F} would pass
+	 * the series gate in halmac_init_adapter() but skip mount_api_8822b()
+	 * (those per-chip branches compile empty), leaving NULL api slots and a
+	 * pc=0x0 oops at rtw_halmac_init_adapter. Force 8822B. */
+	if (chip_id != CHIP_ID_HW_DEF_8822B) {
+		printk(KERN_ALERT "AIPRO8822BU: force chip_id 0x%02x -> 0x0A (8822B)\n",
+		       chip_id);
+		chip_id = CHIP_ID_HW_DEF_8822B;
+	}
+
 	if (chip_id == CHIP_ID_HW_DEF_8822B) {
 		adapter->chip_id = HALMAC_CHIP_ID_8822B;
 	} else if (chip_id == CHIP_ID_HW_DEF_8821C) {
-- 
